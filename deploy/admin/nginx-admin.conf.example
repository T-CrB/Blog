# Paste only inside the blog's HTTPS server { ... }, not the HTTP redirect block.
location ^~ /admin/ {
    # Define tcrb_admin_login in the http block first (see nginx-admin-rate-limit.conf.example).
    limit_req zone=tcrb_admin_login burst=5 nodelay;
    limit_req_status 429;
    access_log off;
    proxy_cache off;
    proxy_intercept_errors off;
    client_max_body_size 256k;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Connection "";
    proxy_connect_timeout 3s;
    proxy_read_timeout 65s;
    proxy_pass http://127.0.0.1:8765;
}
