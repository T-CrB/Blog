server {
    listen 80;
    listen [::]:80;

    server_name example.com www.example.com;
    root /var/www/tcrb-web;
    index index.html;

    location / {
        try_files $uri $uri/ $uri.html =404;
    }

    location = /404.html {
        internal;
    }

    location /_astro/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
}
